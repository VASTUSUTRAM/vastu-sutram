{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "{index.html,css/**,js/**,assets/**,data/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js",
      "headers": {
        "x-content-type-options": "nosniff",
        "x-frame-options": "SAMEORIGIN",
        "x-xss-protection": "1; mode=block"
      }
    }
  ]
}
